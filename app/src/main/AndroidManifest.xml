<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" /> <application
    android:icon="@mipmap/ic_launcher"
    android:label="Note, Remind Me"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.NoteRemindMe">

    <activity
        android:name=".ViewContentActivity"
        android:windowSoftInputMode="adjustResize">
    </activity>
    <activity android:name=".EditNoteActivity" android:exported="false" />
    <activity android:name=".MainActivity" android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
    </activity>
    <activity android:name=".AddNoteActivity" android:exported="false" />

    <receiver
        android:name=".AlarmReceiver"
        android:enabled="true"
        android:exported="false" />

</application>
</manifest>